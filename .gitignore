# Dependencies
node_modules/

# WhatsApp session / credentials -- never commit
session/
auth/

# Runtime data: user profiles, chat rules, settings, stats and WhatsApp session.
# Never commit this directory -- it contains real user JIDs and preferences.
# Four exceptions, all authored/config data rather than user data:
#   changelog.json   the published version history
#   botContent.json  the admin Content & Timing editor's live values
#   groups.json      activated-group registry (group JIDs, no personal data)
#   groupStats.json  reserved for Phase 6 group stats
#   groupDefaults.json  defaults applied to newly activated groups
data/*
!data/changelog.json
!data/botContent.json
!data/groups.json
!data/groupStats.json
!data/groupDefaults.json

# Environment-specific notification bookkeeping (never shared between hosts)
data/lastNotifiedChangeId.json
data/changelogDrafts.json

# Environment
.env
.env.local

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/